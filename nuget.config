<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Org packages (RakNexus, AssetData.Parser.Core) come from GitHub Packages.
       Credentials are never committed; CI injects them via the env var
       NuGetPackageSourceCredentials_github (Username=actions;Password=GITHUB_TOKEN).
       Local dev: set that env var, or register the github source with a PAT
       (scope read:packages). See the org RELEASING.md for the exact command. -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/Resurrection-Capsule/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="RakNexus" />
      <package pattern="AssetData.Parser*" />
      <package pattern="ReCap.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
